    "@angular/elements": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "openlms-angular-lib": "git+ssh://git@gitlab.com:open-lms/product/edu/openlms-angular-lib.git",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^10.10.0",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^22.20.3",
    "angular-eslint": "^21.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "karma-junit-reporter": "^2.0.1",
